# 复制为项目根目录 .env，填入后重启 npm start。
YITI_PORT=4318

# Gemini：文字部分（TEXT_PROVIDER=gemini 时）和语音陪练都用它。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# minimal / low / medium / high；留空用模型默认。
GEMINI_THINKING_LEVEL=low
# 翻译单独用更便宜的模型。
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
# 拆块要读整道例题，等得久一些。
GEMINI_PREPARATION_TIMEOUT_MS=60000

# 语音陪练用谁：gemini（Gemini Live）或 qwen（阿里云百炼 Qwen-Omni-Realtime，中国大陆可用）。
VOICE_PROVIDER=gemini

# Gemini Live 的设置。
GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
VOICE_THINKING_LEVEL=LOW
VOICE_MAX_SECONDS=600
VOICE_IDLE_SECONDS=90

# 文字部分（翻译、拆块、检查、点评）用谁：gemini、deepseek 或 qwen（阿里云百炼，用下面的百炼 key）。
TEXT_PROVIDER=gemini
# DeepSeek 直连。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 阿里云百炼（VOICE_PROVIDER=qwen 时）。API key 按区域分开：cn-beijing（中国大陆）或 ap-southeast-1（国际，新加坡）。
# 工作空间 ID 在百炼控制台可查；留空时使用该区域的公共地址。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime
# TEXT_PROVIDER=qwen 时：拆块、检查、点评要做数学判断，用 max；翻译用 flash。默认不开思考（开了检查要等 10 秒以上）。
QWEN_TEXT_MODEL=qwen3.8-max
QWEN_TRANSLATE_MODEL=qwen3.8-flash
QWEN_THINKING=off
QWEN_VOICE=longanlingxin
