{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "一题",
  "version": "0.3.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "homepage_url": "https://github.com/John15263/yiti",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "web/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "https://*.maas.aliyuncs.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mathacademy.com/*",
        "https://www.mathacademy.com/*"
      ],
      "js": [
        "extract.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mathacademy.com/*",
        "https://www.mathacademy.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
