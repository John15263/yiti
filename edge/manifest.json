{
  "manifest_version": 3,
  "name": "一题 · Math Academy 中文陪练",
  "short_name": "一题",
  "version": "0.2.0",
  "description": "在侧边栏跟着 Math Academy 学：中文翻译、例题拆块先看懂再默写、做完题说一句关键步骤、语音补前置知识。用你自己的 API key，不经过任何第三方服务器。",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "打开一题", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "web/index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "https://*.maas.aliyuncs.com/*"
  ],
  "content_scripts": [
    { "matches": ["https://mathacademy.com/*", "https://www.mathacademy.com/*"], "js": ["extract.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://mathacademy.com/*", "https://www.mathacademy.com/*"], "js": ["relay.js"], "run_at": "document_idle" }
  ]
}
